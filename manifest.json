{
  "manifest_version": 3,
  "name": "MAX File Previewer",
  "version": "1.0.3",
  "description": "Предпросмотр Office-документов, архивов, кода (с запуском!) и медиа в мессенджере MAX.",
  "permissions": [
    "tabs",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.max.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://web.max.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/viewer.html",
        "viewer/viewer.js",
        "viewer/viewer.css",
        "viewer/libs/*",
        "viewer/libs/luckysheet/*",
        "viewer/libs/luckysheet/assets/iconfont/*",
        "viewer/runner.html",
        "viewer/runner.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "viewer/runner.html"
    ]
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
